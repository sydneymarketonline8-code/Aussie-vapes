# ── Site Identity ─────────────────────────────────────────────
# Your production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://vapevaultau.com.au

# Override the site name shown in metadata and schema
NEXT_PUBLIC_SITE_NAME=VapeVault AU

# ── Supabase (admin auth + future data layer) ─────────────────
# Required for /admin/* — without these the middleware lets
# requests through unprotected and the login form errors with
# ?error=config. Find these in:
#   Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key...

# Server-only key — NEVER expose to the browser. Used by
# server-side scripts that must bypass RLS (e.g. product import).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key...

# ── Analytics (add when ready) ────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Payment ───────────────────────────────────────────────────
# Sales team will provide the real values before launch — these
# are server-only (no NEXT_PUBLIC_ prefix) so the actual addresses
# never reach the browser. They're rendered into the success page
# (and the sales notification) on the server.
PAYID_ADDRESS=payments@example.com.au
PAYID_NAME=Vapes Australia Pty Ltd
BTC_WALLET_ADDRESS=bc1qexampleexampleexampleexampleexampleex

# Sales-team notification target. Paste a Slack incoming-webhook
# URL to get a message whenever a pending order is placed.
# If unset, notifications are logged to the server console instead.
SLACK_SALES_WEBHOOK_URL=

# ── Email (transactional — order confirmations) ──────────────
# Optional. If unset, order-confirmation emails are logged to the
# server console instead of being sent. Sign up at resend.com to
# get an API key, then verify your sending domain.
# RESEND_API_KEY=re_...
# RESEND_FROM=Vapes Australia <orders@vapesaustralia.com.au>

# ── Live chat (Crisp) ────────────────────────────────────────
# Optional. Sign up free at https://crisp.chat. Settings →
# Website Settings → Setup Instructions → copy the Website ID
# (UUID) from the snippet: CRISP_WEBSITE_ID = "<id>".
# If unset, the chat widget does not render.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# ── WhatsApp click-to-chat button ────────────────────────────
# Phone in international format, digits only (no +, no spaces).
# If unset the button defaults to the Vapes Australia sales number
# hard-coded in components/layout/WhatsAppButton.tsx.
NEXT_PUBLIC_WHATSAPP_NUMBER=61489929556

# ── Search-engine verification ───────────────────────────────
# Codes given by each engine's webmaster console. Rendered as
# <meta> tags in <head>. Leave blank until you have the code.
#   Google: search.google.com/search-console → add property →
#           HTML tag method → copy the content="..." value.
#   Bing:   bing.com/webmasters → add site → meta tag method →
#           copy the content="..." value.
#   Yandex: webmaster.yandex.com → add site → meta tag method.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ── IndexNow (instant Bing + Yandex push notifications) ──────
# Lets the site tell Bing + Yandex "this URL changed, recrawl
# it" instantly instead of waiting for the next crawl cycle.
# Generate any 8-128 character a-z 0-9 string (e.g.
# `openssl rand -hex 16` for a 32-char hex value).
# Once set, /<KEY>.txt is auto-served at the site root so the
# search engines can verify ownership.
INDEXNOW_KEY=
