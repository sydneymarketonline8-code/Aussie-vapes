# ── Site Identity ─────────────────────────────────────────────
# Your production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://vapevaultau.com.au

# Override the site name shown in metadata and schema
NEXT_PUBLIC_SITE_NAME=VapeVault AU

# ── Supabase (admin auth + future data layer) ─────────────────
# Required for /admin/* — without these the middleware lets
# requests through unprotected and the login form errors with
# ?error=config. Find these in:
#   Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key...

# Server-only key — NEVER expose to the browser. Used by
# server-side scripts that must bypass RLS (e.g. product import).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key...

# ── Analytics (add when ready) ────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Payment ───────────────────────────────────────────────────
# Sales team will provide the real values before launch — these
# are server-only (no NEXT_PUBLIC_ prefix) so the actual addresses
# never reach the browser. They're rendered into the success page
# (and the sales notification) on the server.
PAYID_ADDRESS=payments@example.com.au
PAYID_NAME=Aussie Vapes Pty Ltd
BTC_WALLET_ADDRESS=bc1qexampleexampleexampleexampleexampleex

# Sales-team notification target. Paste a Slack incoming-webhook
# URL to get a message whenever a pending order is placed.
# If unset, notifications are logged to the server console instead.
SLACK_SALES_WEBHOOK_URL=

# ── Email (add for real newsletter/transactional emails) ──────
# RESEND_API_KEY=re_...
